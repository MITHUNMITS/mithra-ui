{
  "name": "mithra-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Mithra UI packages and examples.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @mithra-ui/web",
